            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Postal Code",
            "description": "ZIP or postal code."
          },
          "country": {
            "type": "string",
            "title": "Country",
            "description": "ISO country code or name.",
            "default": "US"
