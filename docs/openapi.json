    "/v1/standardize": {
      "post": {
        "description": "Standardize a single address string or structured address fields with sub-2ms latency.\n\nDeclared as a plain function so FastAPI runs the CPU-bound work in its threadpool instead of\nblocking the event loop (and every other request, including /health).",
        "operationId": "standardize_single_v1_standardize_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StandardizeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardizeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
