    "/v1/autocomplete": {
      "get": {
        "description": "GET endpoint for interactive typeahead address search.",
        "operationId": "autocomplete_get_v1_autocomplete_get",
        "parameters": [
          {
            "description": "Partial address query",
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "description": "Partial address query",
              "minLength": 1,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "description": "Max results",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 10,
              "description": "Max results",
              "maximum": 50,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "Optional state filter",
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional state filter",
              "title": "State"
            }
          },
          {
            "description": "Optional user latitude",
            "in": "query",
            "name": "lat",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 90,
                  "minimum": -90,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional user latitude",
              "title": "Lat"
            }
          },
          {
            "description": "Optional user longitude",
            "in": "query",
            "name": "lon",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maximum": 180,
                  "minimum": -180,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional user longitude",
              "title": "Lon"
            }
          },
          {
            "description": "Optional radius in miles",
            "in": "query",
            "name": "radius_miles",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "maximum": 25000,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional radius in miles",
              "title": "Radius Miles"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AutocompleteResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Typeahead address autocomplete (GET)",
        "tags": [
          "Autocomplete"
        ]
      },
      "post": {
        "description": "Real-time typeahead address suggestion with secondary unit prompting and proximity biasing.",
        "operationId": "autocomplete_post_v1_autocomplete_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AutocompleteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AutocompleteResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Typeahead address autocomplete",
        "tags": [
          "Autocomplete"
        ]
      }
    },
