  "info": {
    "description": "High-performance universal address standardization, pure offline rooftop geocoding, CASS Cycle N deliverability verification, and real-time typeahead autocomplete daemon.",
    "title": "Address Standardizer Microservice API",
    "version": "3.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "Returns microservice health, engine capability matrix, and cache telemetry.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health and readiness probe",
        "tags": [
          "Diagnostics"
        ]
      }
    },
    "/metrics": {
      "get": {
        "description": "Returns runtime throughput, request counts, and execution latencies.",
        "operationId": "get_metrics_metrics_get",
        "parameters": [
          {
            "description": "Metric format: 'json' or 'prometheus'",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Metric format: 'json' or 'prometheus'",
              "title": "Format"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Service telemetry and metrics",
        "tags": [
          "Diagnostics"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "Readiness: 200 when the cache, audit ledger and reference database are usable, else 503 (names only).",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness probe",
        "tags": [
