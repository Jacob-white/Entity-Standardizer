          },
          "fips_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fips Code"
          },
          "full_rooftop_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Rooftop Address"
          },
          "is_private_residence": {
            "default": false,
            "title": "Is Private Residence",
            "type": "boolean"
          },
          "is_registered_agent_hub": {
            "default": false,
            "title": "Is Registered Agent Hub",
            "type": "boolean"
          },
          "is_us": {
            "title": "Is Us",
            "type": "boolean"
          },
          "latitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude"
          },
          "normalized_address_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Normalized Address Key"
          },
          "phonetic_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phonetic Key"
          },
          "postal_code": {
