{
  "components": {
    "schemas": {
      "AutocompleteRequest": {
        "description": "Payload for real-time typeahead address suggestion.",
        "properties": {
          "latitude": {
            "anyOf": [
              {
                "maximum": 90.0,
                "minimum": -90.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Client latitude for proximity ranking",
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "maximum": 180.0,
                "minimum": -180.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Client longitude for proximity ranking",
            "title": "Longitude"
          },
          "max_results": {
            "default": 10,
            "description": "Max suggestions to return",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Max Results",
            "type": "integer"
          },
          "query": {
            "description": "Partial address input string",
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "radius_miles": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 25000.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Proximity radius bounding in miles",
            "title": "Radius Miles"
          },
          "state_filter": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "US State postal filter (e.g. CA, NY)",
            "title": "State Filter"
          }
        },
        "required": [
          "query"
        ],
        "title": "AutocompleteRequest",
        "type": "object"
      },
      "AutocompleteResponse": {
        "description": "List of autocomplete suggestions.",
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/AutocompleteSuggestionItem"
            },
            "title": "Suggestions",
            "type": "array"
          }
        },
        "required": [
          "suggestions",
          "count"
        ],
        "title": "AutocompleteResponse",
        "type": "object"
      },
      "AutocompleteSuggestionItem": {
        "description": "Individual autocomplete suggestion.",
        "properties": {
          "city": {
            "title": "City",
            "type": "string"
          },
          "distance_meters": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Distance Meters"
          },
          "latitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude"
          },
          "postal_code": {
            "title": "Postal Code",
            "type": "string"
          },
          "prompt_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt Message"
          },
          "secondary_prompt_required": {
            "title": "Secondary Prompt Required",
            "type": "boolean"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "street_line": {
            "title": "Street Line",
            "type": "string"
          },
          "suggested_secondary_units": {
            "items": {
              "type": "string"
            },
            "title": "Suggested Secondary Units",
            "type": "array"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "street_line",
          "city",
          "state",
          "postal_code",
          "secondary_prompt_required",
          "suggested_secondary_units"
        ],
        "title": "AutocompleteSuggestionItem",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "StandardizeRequest": {
        "description": "Input payload for single address standardization.",
        "example": {
          "address": "1600 Pennsylvania Ave NW, Washington, DC 20500",
          "enable_fuzzy": true,
          "enable_geocoding": true
        },
        "properties": {
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Single-line address string",
            "title": "Address"
          },
          "allow_locality": {
            "default": false,
            "description": "Allow locality-only / city-level fallback",
            "title": "Allow Locality",
            "type": "boolean"
          },
          "alternatives": {
            "default": 0,
            "description": "Add up to N next-best interpretations of an ambiguous input as `alternatives`.",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Alternatives",
            "type": "integer"
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "City / Locality name",
            "title": "City"
          },
          "correct_state_from_zip": {
            "default": false,
            "description": "Replace a US state that contradicts the ZIP with the ZIP's state (reported as WARN_STATE_CORRECTED_FROM_ZIP). Off by default: a mismatching state is kept and the address is flagged ERR_ZIP_STATE_MISMATCH / UNDELIVERABLE.",
            "title": "Correct State From Zip",
            "type": "boolean"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "USA",
            "description": "Country name or ISO-3166 code",
            "title": "Country"
          },
          "enable_fuzzy": {
            "default": true,
            "description": "Enable Levenshtein typo correction",
            "title": "Enable Fuzzy",
            "type": "boolean"
          },
          "enable_geocoding": {
            "default": true,
            "description": "Enable offline rooftop/TIGER geocoding",
            "title": "Enable Geocoding",
            "type": "boolean"
          },
          "include_explanation": {
            "default": false,
            "description": "Add `explanation` (ordered change records) and `field_confidence` (per-field, heuristic) to the response.",
            "title": "Include Explanation",
            "type": "boolean"
          },
          "include_metadata": {
            "default": true,
            "description": "Include delivery intelligence and spatial metadata",
            "title": "Include Metadata",
            "type": "boolean"
          },
          "postal_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Postal / ZIP code",
            "title": "Postal Code"
          },
          "state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "State / Province code",
            "title": "State"
          },
          "street1": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Primary street line",
            "title": "Street1"
          },
          "street2": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Secondary unit (Suite, Apt, Floor)",
            "title": "Street2"
          }
        },
        "title": "StandardizeRequest",
        "type": "object"
      },
      "StandardizeResponse": {
        "additionalProperties": true,
        "description": "Standardized USPS Pub 28 / ISO address output schema.",
        "properties": {
          "accuracy_radius_meters": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accuracy Radius Meters"
          },
          "address_status": {
            "title": "Address Status",
            "type": "string"
          },
          "alternatives": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Alternatives"
          },
          "building_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Building Key"
          },
          "care_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Care Of"
          },
          "census_tract": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Census Tract"
          },
          "city": {
            "title": "City",
            "type": "string"
          },
          "cmra": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cmra"
          },
          "confidence_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence Score"
          },
          "corporate_risk_flags": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Corporate Risk Flags"
          },
          "corporate_risk_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Corporate Risk Score"
          },
          "country": {
            "title": "Country",
            "type": "string"
          },
          "country_iso3": {
            "title": "Country Iso3",
            "type": "string"
          },
          "deliverability": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deliverability"
          },
          "dpv_footnotes": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dpv Footnotes"
          },
          "explanation": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation"
          },
          "field_confidence": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
